# Copy this file to config/.env and set real values.

# Required for Discord delivery.
# Primary key used by this project:
TENDER_WEBHOOK_URL=
# Compatible aliases also accepted by notifier:
# TENDER_DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# Scoring and selection.
TENDER_MIN_SCORE=20
TENDER_SHORTLIST_N=10
TENDER_DECISION_BID_MIN_SCORE=40
TENDER_DECISION_REVIEW_MIN_SCORE=28

# FTS ingest modes: incremental | recovery | backfill
TENDER_INGEST_MODE=incremental
TENDER_FTS_RECOVERY_DAYS=3
TENDER_FTS_BACKFILL_CHUNK_DAYS=3
TENDER_FTS_MAX_REQUESTS_INCREMENTAL=10
TENDER_FTS_MAX_REQUESTS_RECOVERY=25
TENDER_FTS_MAX_REQUESTS_BACKFILL=200
# Optional explicit backfill bounds (ISO8601)
# TENDER_FTS_BACKFILL_START=2026-01-01T00:00:00+00:00
# TENDER_FTS_BACKFILL_END=2026-02-01T00:00:00+00:00

# Optional deterministic pattern enrichment.
TENDER_PATTERN_MODE=enabled_no_score_adjustment
TENDER_PATTERN_MAX_ADJUSTMENT=5
TENDER_PATTERN_HISTORY_RUN_LIMIT=50

# Notification output.
TENDER_NOTIFY_N=5

# Cleanup policy (days to keep heavy JSONL artifacts).
TENDER_RAW_RETENTION_DAYS=7

# Optional legacy compatibility values:
# TENDER_TOP_N=10
