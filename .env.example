# Public template only. Copy to .env locally and fill real values there.

# Provider API keys
COMPANIES_HOUSE_API_KEY=
HUNTER_API_KEY=

# TenderNed XML connector. Leave blank until official credentials are issued.
TENDERNED_XML_USERNAME=
TENDERNED_XML_PASSWORD=
TENDERNED_XML_BASE_URL=https://www.tenderned.nl/papi/tenderned-rs-tns/v2

# Hostinger draft mailbox integration
HOSTINGER_EMAIL=your-mailbox@example.com
HOSTINGER_EMAIL_PASSWORD=
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_DRAFTS_FOLDER=Drafts

# Optional SMTP settings, only if SMTP verification or sending is introduced
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Local paths. Keep pointed at ignored local data folders.
TENDER_ENGINE_ROOT=/opt/tender_engine/
WAREHOUSE_PATH=data/warehouse/procurement.duckdb
DASHBOARD_EXPORT_DIR=data/export/
